# SALUS demo environment. Copy to .env for local runs.
# All services used by the hackathon demo are free tier.

DJANGO_DEBUG=1
SALUS_DEMO_MODE=1
DJANGO_SECRET_KEY=salus-local-dev-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SALUS_HASH_SALT=salus-demo-salt-v1
# Investigations below this match score are treated as not meaningful.
SALUS_MATCH_THRESHOLD=0.3
DATABASE_URL=

# Optional. Leave empty to use the deterministic report composer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8
GEMINI_RETRIES=1

# Comma separated origins for Flutter web.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5000
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Flutter web build target.
API_BASE=http://localhost:8000
